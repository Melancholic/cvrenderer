# Normalize all text files to LF in the repo and working tree. This service is
# built into a Linux container, so LF is what we want everywhere — regardless of
# each contributor's core.autocrlf setting.
* text=auto eol=lf

# Binary assets: never apply text/EOL conversion.
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.wasm  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
